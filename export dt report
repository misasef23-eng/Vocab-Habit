  function pickVoice(lang){
    var best=null,bs=-1;
    snd.voices.forEach(function(v){
      var l=String(v.lang||"").toLowerCase().replace("_","-");
      if(l.indexOf(lang)!==0)return;
      var sc=0;
      if(v.localService)sc+=4;
      if(lang==="zh"?(l==="zh-cn"||l==="zh-hans-cn"):l==="en-us")sc+=2;
      if(v.default)sc+=1;
      if(sc>bs){bs=sc;best=v}
    });
    return best;
  }
  function sndMsg(t){document.querySelectorAll(".sndmsg").forEach(function(m){m.textContent=t||""})}
  function sndErr(code,lang){
    var ln=lang==="zh"?"tiếng Trung":"tiếng Anh";
    if(code==="network")return "Giọng đọc này cần mạng. Hãy cài giọng đọc "+ln+" ngoại tuyến trong Cài đặt của thiết bị.";
    if(code==="not-allowed")return "Trình duyệt đang chặn âm thanh. Hãy bấm nút Nghe lần nữa.";
    return "Thiết bị chưa có giọng đọc "+ln+". Bạn có thể cài thêm trong Cài đặt của thiết bị (mục Giọng nói / Text-to-speech).";
  }
  function speak(text,lang,btn){
    if(!SND_OK){sndMsg("Trình duyệt này chưa hỗ trợ phát âm.");return}
    var ss=window.speechSynthesis;
    try{ss.cancel()}catch(e){}
    if(!snd.voices.length)loadVoices();
    var v=pickVoice(lang),u=new window.SpeechSynthesisUtterance(text),started=false;
    u.lang=lang==="zh"?"zh-CN":"en-US";
    if(v){u.voice=v;u.lang=v.lang}
    u.rate=lang==="zh"?.85:.9;
    if(v&&!v.localService&&navigator.onLine===false){sndMsg(sndErr("network",lang));return}
    if(!v&&snd.voices.length){sndMsg(sndErr("voice",lang));return}
    sndMsg("");
    if(btn)btn.classList.add("on");
    u.onstart=function(){started=true};
    u.onend=function(){started=true;if(btn)btn.classList.remove("on")};
    u.onerror=function(e){
      if(btn)btn.classList.remove("on");
      var c=e&&e.error;
      if(c&&c!=="canceled"&&c!=="interrupted")sndMsg(sndErr(c,lang));
    };
    try{ss.speak(u)}catch(e){if(btn)btn.classList.remove("on");sndMsg("Không phát được âm thanh.");return}
    setTimeout(function(){
      if(!started&&btn&&btn.classList.contains("on")){btn.classList.remove("on");sndMsg("Chưa phát được âm thanh. Hãy kiểm tra âm lượng, hoặc cài giọng đọc ngoại tuyến trong Cài đặt của thiết bị.")}
    },3000);
  }
